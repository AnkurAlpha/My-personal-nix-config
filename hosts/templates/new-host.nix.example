# Inactive example: review every choice and generate hardware on the target.
{ ... }: {
  imports = [
    ./hardware-configuration.nix
    ../../modules/profiles/machine.nix
  ];
  networking.hostName = "newpc";
  my.machine = {
    username = "alice";
    desktop = "minimal";
    graphics = "amd";
  };
  # UEFI example only. Verify FAT32 ESP mount/type and existing boot files.
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = false;
  boot.loader.efi.efiSysMountPoint = "/boot";
  fileSystems."/boot".options = [ "fmask=0077" "dmask=0077" ];
  # Initial version for a NEW install; never bump this as an update mechanism.
  system.stateVersion = "26.05";
}
